APP_NAME="Rent Car System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

# false on a fresh upload: every page leads to the /instalar wizard until the
# database is connected. The wizard (or `php artisan rentcar:install`) sets it to true.
APP_INSTALLED=true
BUSINESS_TIMEZONE=America/Santo_Domingo

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rent_car
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Where uploads (vehicle photos, contract photos, logos) are kept and served from.
# Relative paths start at the project root. Default: public/media, served at APP_URL/media.
# On shared hosting with public_html the package uses MEDIA_ROOT=../media.
# MEDIA_ROOT=public/media
# MEDIA_URL=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Botón "Generar con IA" (resumen y descripción de vehículos). Clave de https://console.groq.com
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
